{
  "kind": "collectionType",
  "collectionName": "lessons",
  "info": {
    "singularName": "lesson",
    "pluralName": "lessons",
    "displayName": "Lesson",
    "description": "Individual lesson with content or challenge"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "type": {
      "type": "enumeration",
      "enum": ["content", "challenge"],
      "default": "content",
      "required": true
    },
    "content": {
      "type": "richtext"
    },
    "order": {
      "type": "integer",
      "required": true,
      "default": 0,
      "min": 0
    },
    "xp_reward": {
      "type": "integer",
      "default": 10,
      "min": 0
    },
    "module": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::module.module",
      "inversedBy": "lessons"
    },
    "challenge": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::challenge.challenge"
    }
  }
}
